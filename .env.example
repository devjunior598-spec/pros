# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Server-only Supabase service access
SUPABASE_SERVICE_ROLE_KEY=

# U.S. payment processing (add Stripe Connect before enabling rent collection or payouts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email and messaging
RESEND_API_KEY=
BREVO_API_KEY=
TERMII_API_KEY=

# Production rate limiting. Required for distributed deployments.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs
CRON_SECRET=

# Optional external services
OPENAI_API_KEY=
NINJA_CLIENT_KEY=
NINJA_CLIENT_SECRET=
NINJA_ENVIRONMENT=
